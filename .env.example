# Copy to `.env` and fill in. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model. Default is claude-opus-5.
# For high-volume single-line triage, these are cheaper and plenty capable:
#   claude-haiku-4-5   ($1 / $5 per 1M tokens)
#   claude-sonnet-5    ($3 / $15 per 1M tokens)
# CERBERUS_MODEL=claude-haiku-4-5
